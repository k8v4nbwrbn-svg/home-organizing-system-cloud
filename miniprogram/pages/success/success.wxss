.success-page {
  padding-top: 76rpx;
}

.success-stepper {
  margin-top: 34rpx;
  margin-bottom: 0;
}

.result-card {
  margin-top: 34rpx;
  padding: 34rpx;
  border-radius: 12rpx;
  background: #17211e;
  color: #ffffff;
}

.result-label {
  color: #a8b8b2;
  font-size: 27rpx;
}

.result-price {
  margin: 12rpx 0 6rpx;
  font-size: 52rpx;
  font-weight: 700;
}

.result-meta {
  color: #9aaba5;
  font-size: 26rpx;
}

.result-divider {
  height: 1rpx;
  margin: 28rpx 0;
  background: rgba(255,255,255,0.12);
}

.result-line {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 10rpx 0;
  color: #d0dcd7;
  font-size: 28rpx;
}

.status-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255,255,255,0.12);
  color: #bcdbd0;
  font-size: 27rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #58ca98;
}

.next-step {
  margin-top: 24rpx;
  padding: 28rpx;
  border-left: 6rpx solid #d89432;
  background: #fff8ed;
}

.next-title {
  margin-bottom: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.next-copy {
  color: #6b736f;
  font-size: 28rpx;
  line-height: 1.7;
}
