<view class="page-shell">
  <view class="hero">
    <view class="eyebrow">HOME ORGANIZING</view>
    <view class="display-title">把家交给专业收纳师</view>
    <view class="subcopy">先使用微信授权登录，再填写联系信息和房屋需求，获取即时预算。客服会在收到需求后与你确认上门时间。</view>
  </view>

  <view class="stepper">
    <view class="step active">
      <view class="step-index">1</view>
      <text>填写信息</text>
    </view>
    <view class="step">
      <view class="step-index">2</view>
      <text>选择需求</text>
    </view>
    <view class="step">
      <view class="step-index">3</view>
      <text>获取报价</text>
    </view>
  </view>

  <view class="trust-row">
    <view class="trust-item">
      <text class="trust-number">01</text>
      <text>微信登录</text>
    </view>
    <view class="trust-item">
      <text class="trust-number">02</text>
      <text>需求评估</text>
    </view>
    <view class="trust-item">
      <text class="trust-number">03</text>
      <text>即时预算</text>
    </view>
  </view>

  <view class="panel">
    <view class="panel-title">微信登录</view>
    <view class="panel-note">使用微信身份登录，方便查看服务安排、会员权益并预约。</view>

    <view wx:if="{{!loggedIn}}" class="login-block">
      <view class="login-intro">
        <view class="login-icon">微信</view>
        <view>
          <view class="login-title">微信一键登录</view>
          <view class="login-copy">授权后自动识别会员身份，无需重复注册。</view>
        </view>
      </view>
      <checkbox-group bindchange="handleAgreementChange">
        <label class="agreement-row">
          <checkbox value="accepted" checked="{{agreementAccepted}}" color="#0f6d5a" />
          <text>我已阅读并同意《用户协议》和《隐私政策》</text>
        </label>
      </checkbox-group>
      <button class="primary-button wechat-login-button" hover-class="button-hover" bindtap="wechatLogin" loading="{{loginLoading}}" disabled="{{loginLoading}}">微信登录</button>
    </view>

    <view wx:if="{{error}}" class="error-box">{{error}}</view>

    <view wx:if="{{loggedIn}}" class="logged-in-block">
      <view class="login-state">
        <text class="login-state-dot"></text>
        <text>微信已登录</text>
      </view>
      <view class="field">
        <text class="field-label">称呼 / 姓名</text>
        <input class="text-input {{focusedField === 'name' ? 'input-active' : ''}}" data-field="name" value="{{name}}" bindinput="handleInput" bindfocus="handleFocus" bindblur="handleBlur" placeholder="例如：王女士" />
      </view>
      <view class="field">
        <text class="field-label">小区 / 地址（选填）</text>
        <input class="text-input {{focusedField === 'address' ? 'input-active' : ''}}" data-field="address" value="{{address}}" bindinput="handleInput" bindfocus="handleFocus" bindblur="handleBlur" placeholder="例如：XX小区 3 栋" />
      </view>
      <view class="orders-entry" hover-class="card-hover" bindtap="viewOrders">
        <text>查看我的订单与预约进度</text>
        <text class="orders-entry-arrow">›</text>
      </view>
      <view class="orders-entry" hover-class="card-hover" bindtap="viewCoupons">
        <text>查看我的优惠券</text>
        <text class="orders-entry-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="support-entry" hover-class="card-hover" bindtap="viewSupport">
    <view>
      <view class="support-entry-title">添加客服微信</view>
      <view class="support-entry-copy">查看客服微信二维码，咨询服务和上门时间</view>
    </view>
    <text class="orders-entry-arrow">›</text>
  </view>

  <view class="service-note">
    <text>全屋收纳 · 厨房整理 · 衣橱整理 · 搬家还原</text>
  </view>

  <view wx:if="{{loggedIn}}" class="panel phone-panel">
    <view class="panel-title">手机号绑定</view>
    <view class="panel-note">微信登录和手机号分开绑定。请手动填写常用手机号，客服会通过该号码联系你。</view>
    <view class="field">
      <text class="field-label">手机号码</text>
      <input class="text-input {{focusedField === 'phone' ? 'input-active' : ''}} {{phoneBound ? 'bound-input' : ''}}" type="number" maxlength="11" disabled="{{phoneBound}}" data-field="phone" value="{{phone}}" bindinput="handleInput" bindfocus="handleFocus" bindblur="handleBlur" placeholder="请输入常用手机号" />
      <view wx:if="{{phoneBound}}" class="phone-bound-state"><text class="login-state-dot"></text>手机号已绑定</view>
    </view>
    <button class="primary-button" hover-class="button-hover" bindtap="bindPhoneAndContinue">{{phoneBound ? '下一步 · 填写房屋需求' : '绑定手机号并继续'}}</button>
  </view>

  <view class="share-card">
    <view class="share-title">把服务分享给朋友</view>
    <view class="share-copy">分享小程序后，朋友也可以直接登记需求并获取预算。</view>
    <button class="secondary-button share-mini-button" open-type="share" hover-class="button-hover">分享小程序</button>
  </view>

  <view wx:if="{{loggedIn}}" class="logout-wrap">
    <button class="logout-button" hover-class="button-hover" bindtap="logoutWechat">退出微信登录</button>
  </view>
</view>
