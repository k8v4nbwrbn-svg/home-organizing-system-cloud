page {
  min-height: 100%;
  background: #f3f5f2;
  color: #17201d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 32rpx;
}

button {
  margin: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 48rpx 36rpx 72rpx;
  box-sizing: border-box;
}

.eyebrow {
  color: #0f6d5a;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.display-title {
  margin: 18rpx 0 14rpx;
  font-size: 58rpx;
  font-weight: 700;
  line-height: 1.16;
  letter-spacing: -1rpx;
}

.subcopy {
  color: #67736e;
  font-size: 31rpx;
  line-height: 1.7;
}

.panel {
  margin-top: 28rpx;
  padding: 30rpx;
  border: 1rpx solid #dce3de;
  border-radius: 12rpx;
  background: #ffffff;
}

.panel-title {
  margin-bottom: 8rpx;
  color: #17201d;
  font-size: 36rpx;
  font-weight: 700;
}

.panel-note {
  margin-bottom: 24rpx;
  color: #77837e;
  font-size: 28rpx;
  line-height: 1.6;
}

.field {
  margin-top: 24rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #3d4a44;
  font-size: 29rpx;
  font-weight: 600;
}

.text-input,
.textarea,
.picker-field {
  width: 100%;
  min-height: 92rpx;
  padding: 24rpx;
  box-sizing: border-box;
  border: 1rpx solid #cbd5cf;
  border-radius: 10rpx;
  background: #ffffff;
  color: #17201d;
  font-size: 32rpx;
}

.textarea {
  min-height: 170rpx;
}

.placeholder {
  color: #9aa6a1;
}

.primary-button,
.secondary-button {
  display: flex;
  width: 100%;
  min-height: 94rpx;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  font-size: 34rpx;
  font-weight: 700;
  transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease, transform 100ms ease;
}

.primary-button {
  background: #0f6d5a;
  color: #ffffff;
}

.primary-button[disabled] {
  background: #91aaa2;
  color: #e8eeeb;
}

.secondary-button {
  border: 1rpx solid #c9d4ce;
  background: #ffffff;
  color: #34433d;
}

.button-hover {
  transform: scale(0.985);
  opacity: 0.88;
}

.card-hover {
  background: #e8f2ed !important;
  border-color: #0f6d5a !important;
}

.input-active {
  border-color: #0f6d5a !important;
  background: #f8fcfa !important;
  box-shadow: 0 0 0 5rpx rgba(15, 109, 90, 0.1);
}

.stepper {
  display: flex;
  align-items: flex-start;
  margin: 8rpx 0 34rpx;
}

.step {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #9aa6a1;
  font-size: 25rpx;
  transition: color 160ms ease;
}

.step::before {
  content: "";
  position: absolute;
  top: 19rpx;
  left: -50%;
  width: 100%;
  height: 2rpx;
  background: #dce3de;
}

.step:first-child::before {
  display: none;
}

.step-index {
  position: relative;
  z-index: 1;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 9rpx;
  border: 2rpx solid #cbd5cf;
  border-radius: 50%;
  background: #f3f5f2;
  font-size: 24rpx;
  font-weight: 700;
  transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease;
}

.step.active {
  color: #0f6d5a;
  font-weight: 700;
}

.step.active .step-index {
  border-color: #0f6d5a;
  background: #0f6d5a;
  color: #ffffff;
}

.step.done {
  color: #537569;
}

.step.done .step-index {
  border-color: #9bc4b4;
  background: #dcefe6;
  color: #0f6d5a;
}

.section-gap {
  margin-top: 34rpx;
}

.error-box {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  background: #f9eaea;
  color: #9e3434;
  font-size: 29rpx;
}

.success-mark {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e2f1e8;
  color: #1f7657;
  font-size: 58rpx;
  font-weight: 700;
}
